# Dieselben Werte wie in EasyConsulting/.env (öffentliche Web-Konfiguration, kein Geheimnis).
# Firebase Console → Projekteinstellungen → Allgemein → Meine Apps → Web-App → Konfiguration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nur lokal: mit den Firebase-Emulatoren statt mit dem echten Projekt arbeiten.
# VITE_USE_EMULATORS=true
